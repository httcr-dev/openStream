# ---------- API (apps/api) ----------
PORT=3000
# Origem permitida no CORS (URL do frontend)
WEB_ORIGIN=http://localhost:3001
# URL pública da API, usada para montar links de stream (use o IP da LAN para acessar do celular)
PUBLIC_API_URL=http://localhost:3000

# TMDB: use o "API Read Access Token" (v4, Bearer). Obrigatório para o catálogo.
TMDB_READ_TOKEN=
TMDB_LANGUAGE=pt-BR

# Internet Archive (filmes com título correspondente)
INTERNET_ARCHIVE_ENABLED=true

# Addons Stremio: use somente instâncias que você administra ou tem autorização para consultar.
# A admissão exige IDs allowlisted e uma declaração de autorização por addon.
STREMIO_ADDON_URLS=
STREMIO_ADDON_ALLOWED_IDS=
# JSON: {"addon.id":{"status":"public-domain|creative-commons|licensed|user-owned","licenseUrl":"https://..."}}
# Para user-owned, licenseUrl pode ser omitida.
STREMIO_ADDON_AUTHORIZATIONS={}
# Diretório público é opt-in; mesmo habilitado, só IDs explicitamente allowlisted entram.
STREMIO_ADDON_DISCOVERY_ENABLED=false
STREMIO_ADDON_DIRECTORY_URL=https://addons-stremio.com/api/v1/addons

# Diretório de armazenamento temporário dos torrents P2P
OPENSTREAM_TORRENT_PATH=/tmp/openstream-torrents

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# (opcional) base alternativa do TMDB, útil para testes com mock
# TMDB_BASE_URL=https://api.themoviedb.org/3

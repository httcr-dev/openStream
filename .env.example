# ---------- API (apps/api) ----------
PORT=3000
# Origem permitida no CORS (URL do frontend)
WEB_ORIGIN=http://localhost:3001
# URL pública da API, usada para montar links de stream (use o IP da LAN para acessar do celular)
PUBLIC_API_URL=http://localhost:3000

# TMDB: use o "API Read Access Token" (v4, Bearer). Obrigatório para o catálogo.
TMDB_READ_TOKEN=
TMDB_LANGUAGE=pt-BR

# Internet Archive (filmes com título correspondente)
INTERNET_ARCHIVE_ENABLED=true

# Addons compatíveis com o protocolo Stremio: URLs dos manifests separadas por vírgula.
# O OpenStream carrega os manifests no boot e seleciona automaticamente addons compatíveis.
# Exemplo: https://addon.example/manifest.json
STREMIO_ADDON_URLS=

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# (opcional) base alternativa do TMDB, útil para testes com mock
# TMDB_BASE_URL=https://api.themoviedb.org/3
